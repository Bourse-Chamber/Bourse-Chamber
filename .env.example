# ==============================================================================
# Bourse Chamber — Canonical Production Environment Configuration
# Strictly server-side: never expose secrets to browser JavaScript or Git
# ==============================================================================

# 1. AI Deliberation Engine (OpenRouter)
# Required for real-time multi-agent streaming across the 9 economic personas
# Defaults to anthropic/claude-3.5-haiku if unspecified
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# 2. Crypto Market Data Feed (CoinGecko)
# Required for live prices, market cap, 24h volume, ATH drawdown, and 7d sparkline
COINGECKO_API_KEY=

# 3. Production Database (PostgreSQL / Neon / Supabase)
# Required for permanent persistence of sessions, evidence, votes, verdicts, and watches
DATABASE_URL=

# 4. Distributed Cache & Rate Limiting (Upstash Redis)
# Used for 60-second market feed caching and API abuse protection
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 5. Transactional Alert Dispatch (Transactional Email)
# Used by the review watcher cron to notify analysts when trigger drawdowns occur
EMAIL_API_KEY=
EMAIL_FROM=Bourse Chamber <alerts@bourse-chamber.vercel.app>

# 6. Automated Daily Trigger Cron Authorization
# Used to authenticate /api/cron/watcher requests (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
