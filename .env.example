# ==============================================================================
# BOURSE CHAMBER — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local Next.js runs, or configure each variable
# in your Vercel Project Settings (Settings -> Environment Variables).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (SUPABASE / POSTGRESQL)
# ------------------------------------------------------------------------------
# Recommended: Supabase Transaction Pooler (port 6543) or Direct Connection (port 5432)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-[YOUR_REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Direct Supabase Connection (alternative for migrations):
# DIRECT_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# Supabase API Credentials (optional for client-side / Supabase JS SDK):
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 2. OPENROUTER LLM MULTI-AGENT INFERENCE
# ------------------------------------------------------------------------------
# Server-side only key for running Claude 3.5 Haiku / 9 Persona Deliberation
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 3. COINGECKO CRYPTO MARKET DATA FEED
# ------------------------------------------------------------------------------
# Pro or Demo API Key from CoinGecko (starts with CG-)
COINGECKO_API_KEY="CG-xxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 4. UPSTASH REDIS (CACHE & SLIDING WINDOW RATE LIMITER)
# ------------------------------------------------------------------------------
# Used for 60s market caching (bourse:market:{TICKER}) and rate limiting (10-60 req/min)
UPSTASH_REDIS_REST_URL="https://[YOUR_INSTANCE].upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 5. CRON AUTHORIZATION SECRET
# ------------------------------------------------------------------------------
# Authorization Bearer token securing /api/cron/watcher against unauthorized triggers
CRON_SECRET="bourse_cron_secret_production_key_32chars"

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL DISPATCH (RESEND / SENDGRID)
# ------------------------------------------------------------------------------
# Used by the daily watcher to send email alerts when drawdown thresholds hit
EMAIL_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Bourse Chamber Alerts <alerts@bourse-chamber.com>"

# ------------------------------------------------------------------------------
# 7. RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="production"
